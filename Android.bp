cc_prebuilt_library_shared {
    name: "lyriq_stock_libcomutils",
    defaults: ["lyriq_stock_ims_lib_defaults"],
    srcs: [".local-prebuilts/stock-ims/lib64/libcomutils.so"],
    stem: "libcomutils",
