cc_prebuilt_library_shared {
    name: "lyriq_stock_videotelephony_ndk",
    defaults: ["lyriq_stock_ims_lib_defaults"],
    srcs: [".local-prebuilts/stock-ims/lib64/vendor.mediatek.hardware.videotelephony-V1-ndk.so"],
