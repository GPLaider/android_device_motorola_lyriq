cc_prebuilt_library_shared {
    name: "lyriq_stock_libvt_avsync",
    defaults: ["lyriq_stock_ims_lib_defaults"],
    srcs: [".local-prebuilts/stock-ims/lib64/libvt_avsync.so"],
